# Agentoo shared Git defaults; ~/.gitconfig and repository settings override these.
# Narrow exception: gitconfig-user and gitignore-user stay split out solely so
# usr/local/share/agentoo/installer/user-dots.sh can deploy them to non-agentoo Linux hosts.
[include]
    path = /etc/agentoo/gitconfig-user
[core]
    excludesFile = /etc/agentoo/gitignore-user
[hook "wrap-commit-msg"]
    event = commit-msg
    command = /usr/local/share/agentoo/lib/git_wrap_commit_msg.py
[include]
    path = ~/.gitconfig-local
# Canonical path: usr/local/share/agentoo/lib/paths.py (SYSTEM_GIT_DIR).
[includeIf "gitdir:/var/lib/agentoo/repository.git"]
    path = /etc/agentoo/gitconfig
[safe]
    directory = /var/db/repos/gentoo
    directory = /var/db/repos/hyproverlay
    directory = /var/db/repos/guru
