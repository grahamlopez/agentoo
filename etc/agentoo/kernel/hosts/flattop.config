# Framework i7-1360P: observed 6.18.57-gentoo-dist-bin firmware loads, 2026-10-27.
# i915 DMC/GuC/HuC, AX211 firmware/PNVM, regulatory data, Intel Bluetooth SFI/DDC.
# CPU family 6, model 186 (0xba), stepping 2 -> intel-ucode/06-ba-02.
# No SOF payload: current audio uses snd_hda_intel. Keep installed firmware broad.
# Optional absent iwl-debug-yoyo.bin is not needed for normal Wi-Fi operation.
CONFIG_FW_LOADER=y
CONFIG_MICROCODE=y
CONFIG_EXTRA_FIRMWARE="i915/adlp_dmc.bin i915/adlp_guc_70.bin i915/tgl_huc.bin iwlwifi-so-a0-gf-a0-89.ucode iwlwifi-so-a0-gf-a0.pnvm regulatory.db regulatory.db.p7s intel/ibt-0040-0041.sfi intel/ibt-0040-0041.ddc intel-ucode/06-ba-02"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
