# Ryzen 9 3950X/X570: AMD early microcode, AX200, Intel Bluetooth and Realtek LAN.
# Keep installed firmware broad until both boot paths pass hardware acceptance.
# NVIDIA loads after real-root handoff and uses its package-owned GSP firmware.
# Optional iwl-debug-yoyo.bin is not required for normal Wi-Fi operation.
CONFIG_FW_LOADER=y
CONFIG_MICROCODE=y
CONFIG_EXTRA_FIRMWARE="amd-ucode/microcode_amd_fam17h.bin iwlwifi-cc-a0-77.ucode regulatory.db regulatory.db.p7s intel/ibt-20-1-3.sfi intel/ibt-20-1-3.ddc rtl_nic/rtl8125a-3.fw rtl_nic/rtl8156b-2.fw"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# NVIDIA needs external modules; boot drivers remain built in from the shared union.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# The shared lockdown LSM selects module verification. Allow unsigned bring-up
# without enforcing signatures, signing modules or generating a private key.
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_MODULE_SIG_KEY=""
