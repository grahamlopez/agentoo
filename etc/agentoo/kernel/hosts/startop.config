# Startop Core Ultra 9 285H: 6.18.60-gentoo-dist-bin loads, reviewed 2026-11-05.
# i915 DMC/GuC/HuC/GSC, AX210 API 89/PNVM and regulatory data were observed.
# Keep the Intel Bluetooth DDC companion for cold initialization (btintel.c).
# CPU family 6, model 197 (0xc5), stepping 2 -> intel-ucode/06-c5-02.
# Current audio is HDA/ALC233; no SOF/Cirrus payload requirement established.
# Installed firmware remains broad until both kernel boot paths are accepted.
CONFIG_FW_LOADER=y
CONFIG_MICROCODE=y
CONFIG_EXTRA_FIRMWARE="i915/mtl_dmc.bin i915/mtl_guc_70.bin i915/mtl_huc_gsc.bin i915/mtl_gsc_1.bin iwlwifi-ty-a0-gf-a0-89.ucode iwlwifi-ty-a0-gf-a0.pnvm regulatory.db regulatory.db.p7s intel/ibt-0041-0041.sfi intel/ibt-0041-0041.ddc intel-ucode/06-c5-02"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
