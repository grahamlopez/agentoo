# Thinktop's accepted embedded selection from kernel-shared-v04-config.
# Installed linux-firmware selection remains in /etc/agentoo/firmware/thinktop.list.
CONFIG_FW_LOADER=y
CONFIG_MICROCODE=y
CONFIG_EXTRA_FIRMWARE="i915/mtl_dmc.bin i915/mtl_guc_70.bin i915/mtl_huc_gsc.bin i915/mtl_gsc_1.bin iwlwifi-bz-b0-fm-c0-101.ucode iwlwifi-bz-b0-fm-c0.pnvm regulatory.db regulatory.db.p7s intel/ibt-0093-0291.sfi intel/ibt-0093-0291.ddc intel/sof-ipc4/arl/sof-arl.ri intel/sof-ace-tplg/sof-hda-generic-idisp-2ch.tplg intel/sof-ace-tplg/sof-arl-cs42l43-l2-cs35l56-l3-2ch.tplg cs42l43.bin cirrus/cs35l56-b0-dsp1-misc-17aa2349.wmfw cirrus/cs35l56-b0-dsp1-misc-17aa2349-amp1.bin cirrus/cs35l56-b0-dsp1-misc-17aa2349-amp2.bin intel-ucode/06-c5-02"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
