# Portable user Git global excludes (narrow exception: kept separate from
# /etc/agentoo/gitignore so usr/local/share/agentoo/installer/user-dots.sh can share it).

# Generated Python bytecode
__pycache__/
*.py[cod]

# ssh: track only the shared config; never keys or machine-local includes
.ssh/*
!.ssh/config
.ssh/config.d/

# Local credentials
.config/agentoo/github-token
.pi/agent/auth.json
