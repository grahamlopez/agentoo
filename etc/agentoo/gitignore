# Global excludes (git core.excludesFile).
# Also guards the $HOME-as-work-tree dotfile repos (dgit/ggit/agit) against
# accidentally committing secrets via `add -A`.

# Generated Python bytecode
__pycache__/
*.py[cod]

# Portage owns native shell/editor entry files; track only their extensions.
/etc/zsh/zprofile
/etc/vim/vimrc
/etc/vim/sysinit.vim

# ssh: track only the shared config; never keys or machine-local includes
.ssh/*
!.ssh/config
.ssh/config.d/

# Local secret mappings, templates, and provisioned credentials
/etc/agentoo/secrets/*
!/etc/agentoo/secrets/host-shared.conf
!/etc/agentoo/secrets/flattop.conf
/var/lib/agentoo/secrets/
.config/agentoo/github-token
.pi/agent/auth.json
/etc/wpa_supplicant/wpa_supplicant-*.conf

# Created locally by user setup after Graham exists.
/etc/systemd/system/getty@tty1.service.d/autologin.conf

# Machine-local host selection, storage identity, and native firmware state.
/etc/portage/make.profile
/etc/fstab
/etc/kernel/cmdline
/etc/kernel/gentoo-dist-esp.uuid
/etc/portage/savedconfig/**/sys-kernel/linux-firmware
/etc/portage/savedconfig/**/sys-kernel/linux-firmware-*
