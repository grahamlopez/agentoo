# Native package-specific bashrc; policy lives in kernel/config.d fragments.
post_src_prepare() {
    local generated
    local -a keymap=()
    [[ -z ${AGENTOO_INITRAMFS_KEYMAP:-} ]] || keymap=(--keymap "${AGENTOO_INITRAMFS_KEYMAP}")
    generated=$(mktemp -d "${WORKDIR}/agentoo-initramfs.XXXXXX") || die
    /usr/libexec/agentoo-initramfs/build --work "${generated}/archive" \
        --partuuid "${AGENTOO_INITRAMFS_PARTUUID:?set this input in /etc/portage/env/kernel-local}" \
        --mapper "${AGENTOO_INITRAMFS_MAPPER:?set this input in /etc/portage/env/kernel-local}" \
        "${keymap[@]}" || die
    ./scripts/config --set-str INITRAMFS_SOURCE "${generated}/archive/initramfs.cpio" || die
}

post_src_configure() {
    python3 -B /usr/local/share/agentoo/lib/kernel_host.py \
        "${WORKDIR}/build/.config" "${AGENTOO_INITRAMFS_TRANSPORT:?set this input in /etc/portage/env/kernel-local}" "${ESYSROOT:-/}" || die
}

# No-module kernels still need kmod indexes so built-in drivers are recognized.
post_src_install() {
    touch "${ED}/lib/modules/${KV_FULL}/modules.order" || die
    depmod --all --basedir "${ED}" "${KV_FULL}" || die
}

# Select this installed prepared tree once it exists; the binary package uses
# its explicit release paths and leaves a valid custom-family selection intact.
post_pkg_postinst() {
    eselect kernel set "linux-${KV_FULL}" || die
}
