# Native package-specific bashrc; policy lives in kernel/config.d fragments.
post_src_prepare() {
    local generated
    generated=$(mktemp -d "${WORKDIR}/agentoo-initramfs.XXXXXX") || die
    /usr/libexec/agentoo-initramfs/build --work "${generated}/archive" \
        --partuuid "${AGENTOO_INITRAMFS_PARTUUID:?run agentoo kernel prepare}" \
        --mapper "${AGENTOO_INITRAMFS_MAPPER:?run agentoo kernel prepare}" \
        --keymap "${AGENTOO_INITRAMFS_KEYMAP:?run agentoo kernel prepare}" || die
    ./scripts/config --set-str INITRAMFS_SOURCE "${generated}/archive/initramfs.cpio" || die
}

post_src_configure() {
    python3 -B /usr/local/share/agentoo/lib/kernel_host.py \
        "${WORKDIR}/build/.config" "${AGENTOO_INITRAMFS_TRANSPORT:?run agentoo kernel prepare}" "${ESYSROOT}" || die
}
