# Native Wayland Settings portal; no X11 backend required.
sys-apps/xdg-desktop-portal-gtk wayland -X

# Load JPEG, WebP and other supported static images as well as PNG.
gui-apps/swaybg gdk-pixbuf
x11-libs/gdk-pixbuf jpeg

# Packaged uaccess rules grant the active local session access to display I2C.
app-misc/ddcutil user-permissions -X -usb-monitor
