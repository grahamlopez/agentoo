COMMON_FLAGS="-O2 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"

# Keep build output in English so diagnostics and bug reports are reproducible.
LC_MESSAGES=C.utf8

USE="bluetooth -cups cryptsetup"
ACCEPT_LICENSE="*"
INPUT_DEVICES="evdev libinput"

QEMU_SOFTMMU_TARGETS="x86_64"
QEMU_USER_TARGETS="x86_64"

FEATURES="parallel-fetch"

# Consumed only by the linux-firmware package.env entry.
AGENTOO_LINUX_FIRMWARE_USE="-savedconfig"
