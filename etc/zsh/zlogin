# Wait until personal .zlogin has run before starting the desktop.
if [[ -o interactive && -o login ]]; then
  autoload -Uz add-zsh-hook
  _agentoo_start_desktop() {
    # Run once, including when startup is disabled or the launcher fails.
    add-zsh-hook -d precmd _agentoo_start_desktop
    unfunction _agentoo_start_desktop
    if [[ $USER == graham && $EUID == 1000 &&
          $TTY == /dev/tty1 &&
          -z $WAYLAND_DISPLAY && -z $DISPLAY &&
          ! -e $HOME/.disable-hyprland-autostart ]]; then
      # Keep a shell available when the desktop exits or fails. Never exec here.
      if [[ -x /usr/bin/start-hyprland ]]; then
        /usr/bin/start-hyprland
        print -r -- 'Hyprland exited; console available. Run start-hyprland to retry.'
      else
        print -r -- 'start-hyprland is unavailable; console available.'
      fi
    fi
  }
  add-zsh-hook precmd _agentoo_start_desktop
fi
