# Gentoo login environment; keep package-provided environment integration.
if [[ -e /etc/profile.env ]]; then . /etc/profile.env; fi
export EDITOR=${EDITOR:-/bin/nano}
export PAGER=${PAGER:-/usr/bin/less}
unset ROOTPATH
shopts=$-
setopt nullglob
for sh in /etc/profile.d/*.sh; do [[ -r "$sh" ]] && . "$sh"; done
unsetopt nullglob
set -$shopts
unset sh shopts

# Prefer Neovim, then Vim, after loading the distribution environment.
if (( $+commands[nvim] )); then
  export EDITOR=nvim VISUAL=nvim
elif (( $+commands[vim] )); then
  export EDITOR=vim VISUAL=vim
fi

# Keep a shell available when the desktop exits or fails. Never exec here.
if [[ -o interactive && -o login &&
      $USER == graham && $EUID == 1000 &&
      $TTY == /dev/tty1 &&
      -z $WAYLAND_DISPLAY && -z $DISPLAY &&
      ! -e $HOME/.disable-hyprland-autostart ]]; then
  if [[ -x /usr/bin/start-hyprland ]]; then
    /usr/bin/start-hyprland
    print -r -- 'Hyprland exited; console available. Run start-hyprland to retry.'
  else
    print -r -- 'start-hyprland is unavailable; console available.'
  fi
fi
