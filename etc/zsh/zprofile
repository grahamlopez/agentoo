# Gentoo login environment; keep package-provided environment integration.
if [[ -e /etc/profile.env ]]; then . /etc/profile.env; fi
export EDITOR=${EDITOR:-/bin/nano}
export PAGER=${PAGER:-/usr/bin/less}
unset ROOTPATH
shopts=$-
setopt nullglob
for sh in /etc/profile.d/*.sh; do [[ -r "$sh" ]] && . "$sh"; done
unsetopt nullglob
set -$shopts
unset sh shopts

# Prefer Neovim, then Vim, after loading the distribution environment.
if (( $+commands[nvim] )); then
  export EDITOR=nvim VISUAL=nvim
elif (( $+commands[vim] )); then
  export EDITOR=vim VISUAL=vim
fi
