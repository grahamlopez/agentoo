# Copy to /etc/agentoo/secrets/local.conf and replace the example references.
# Columns: category owner destination method source
# No whitespace in destinations; source is the remainder of the line.
# Keep only rows you want. Vault references are identifiers, not secret values.
ssh user HOME/.ssh/id_ed25519 field pass://VAULT/SSH_ITEM/private key
github user HOME/.config/agentoo/github-token field pass://VAULT/GITHUB_ITEM/password
wifi root /etc/wpa_supplicant/wpa_supplicant-wlan0.conf field pass://VAULT/WIFI_ITEM/note
# A template row uses a local file containing {{ pass://... }} references:
# pi user HOME/.pi/agent/auth.json template /etc/agentoo/secrets/pi-auth.json.template
