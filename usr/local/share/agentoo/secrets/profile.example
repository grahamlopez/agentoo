# Copy to /etc/agentoo/secrets/local.conf and replace the example references.
# Never store secret values here—only Proton Pass vault references (or IDs).
# Local profiles under /etc/agentoo/secrets/ are ignored by /etc/agentoo/gitignore
# unless explicitly un-ignored as reference-only host profiles.
#
# Columns: category owner destination method source
#   category:    label passed to `agentoo secrets install` (or `all`)
#   owner:       `user` (--user account) or `root`
#   destination: absolute path or HOME/... (no whitespace; overwritten at mode 0600;
#                missing parent dirs created as 0700 for user / 0755 for root)
#   method:
#     field    — writes Proton Pass CLI output unchanged (including final newline)
#     uuid     — trims whitespace, validates UUID, writes canonical lowercase without newline
#     template — renders a local file containing {{ pass://vault/item/field }} expressions
#                (plain text substitution; no JSON/shell escaping)
#     github   — writes /var/lib/agentoo/secrets/github.credentials (root 0600) and configures
#                Agentoo's HTTPS push URL from a Proton Pass Login item (Username + Password)
#   source:      remainder of the line (spaces allowed in pass:// references)

# SSH private key
ssh user HOME/.ssh/id_ed25519 field pass://VAULT/SSH_ITEM/private key

# Agentoo repository GitHub push credentials (Login item)
github root /var/lib/agentoo/secrets/github.credentials github pass://VAULT/GITHUB_LOGIN_ITEM

# Plain token file (does not configure Git)
# github-token user HOME/.config/agentoo/github-token field pass://VAULT/GITHUB_ITEM/password

# Secure Boot sbctl Owner GUID (canonical UUID, no trailing newline)
# sbctl-guid root /var/lib/sbctl/GUID uuid pass://VAULT/HOST_ITEM/sbctl_guid

# Native wpa_supplicant config stored in a Proton Pass note (replace wlan0)
# wifi root /etc/wpa_supplicant/wpa_supplicant-wlan0.conf field pass://VAULT/WIFI_ITEM/note

# Rendered template file containing {{ pass://... }} expressions
# pi user HOME/.pi/agent/auth.json template /etc/agentoo/secrets/pi-auth.json.template
