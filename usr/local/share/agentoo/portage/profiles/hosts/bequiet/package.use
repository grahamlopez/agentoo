# Distribution-module rebuilding is enabled by shared kernel policy.
# Enable modules-sign after unsigned kernel/hardware acceptance and signer setup.
x11-drivers/nvidia-drivers modules -modules-sign tools wayland
# Blackwell requires open modules; >=595 provides only that variant.
<x11-drivers/nvidia-drivers-595 kernel-open

# Apply the reviewed host list explicitly with agentoo kernel firmware apply.
sys-kernel/linux-firmware savedconfig -deduplicate -compress-xz -compress-zstd
