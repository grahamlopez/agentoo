# AMD Ryzen 9 3950X (Zen 2), 16 cores / 32 logical CPUs.
COMMON_FLAGS="-march=znver2 -O2 -pipe"
RUSTFLAGS="${RUSTFLAGS} -C target-cpu=znver2"
VIDEO_CARDS="-* nvidia"

# Native Portage module signing; only the public certificate enters the kernel.
MODULES_SIGN_KEY="/var/lib/sbctl/keys/db/db.key"
MODULES_SIGN_CERT="/var/lib/sbctl/keys/db/db.pem"
