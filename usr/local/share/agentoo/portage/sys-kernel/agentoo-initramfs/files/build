#!/usr/bin/env python3
"""Build a machine-specific uncompressed initramfs using installed cryptsetup."""
import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import uuid

HERE = Path(__file__).resolve().parent
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--busybox', type=Path, default=HERE / 'busybox', help='compiled static BusyBox (default: beside this generator)')
p.add_argument('--work', required=True, type=Path, help='new, disposable output directory')
p.add_argument('--partuuid', required=True, help='encrypted root GPT partition UUID')
p.add_argument('--mapper', default='root', help='root mapping name (default: root)')
p.add_argument('--keymap', default='/usr/share/keymaps/i386/qwerty/us-caps.map.gz')
p.add_argument('--check', action='store_true', help='check inputs without creating the workspace or building')
a = p.parse_args()
try:
    a.partuuid = str(uuid.UUID(a.partuuid))
except ValueError:
    p.error('invalid GPT PARTUUID')
if not re.fullmatch(r'[a-zA-Z0-9_+-]+', a.mapper):
    p.error('invalid root mapping name')
if not a.busybox.is_file() or not os.access(a.busybox, os.X_OK):
    p.error(f'compiled BusyBox missing or not executable: {a.busybox}; emerge sys-kernel/agentoo-initramfs, '
            'or use --busybox with a staged binary')
if not Path(a.keymap).is_file():
    p.error(f'console keymap missing: {a.keymap}')
missing = [tool for tool in ('cpio', 'loadkeys', 'strip', 'cryptsetup', 'ldd')
           if shutil.which(tool) is None]
if missing:
    p.error('required tools not found: ' + ', '.join(missing))
cryptsetup = Path(shutil.which('cryptsetup'))
# Inspect only the trusted installed executable, never arbitrary source inputs.
listing = subprocess.check_output(['ldd', str(cryptsetup)], text=True)
if 'not found' in listing:
    p.error('unresolved cryptsetup library')
applets = subprocess.check_output([str(a.busybox.resolve()), '--list'], text=True).split()
required = {'sh', 'mount', 'mkdir', 'sleep', 'switch_root', 'loadkmap', 'umount'}
if not required.issubset(applets):
    p.error('BusyBox is missing required applets: ' + ', '.join(sorted(required - set(applets))))
if a.check:
    print('Minimal initramfs inputs are available.', file=sys.stderr)
    raise SystemExit(0)
work = a.work.resolve()
work.mkdir(parents=True, exist_ok=False)
root = work / 'root'
for directory in ('bin', 'dev', 'proc', 'sys', 'run', 'newroot', 'tmp'):
    (root / directory).mkdir(parents=True)
shutil.copy2(a.busybox, root / 'bin/busybox')
for applet in applets:
    (root / 'bin' / applet).symlink_to('busybox')
shutil.copy2(cryptsetup, root / 'bin/cryptsetup')
for library in sorted(set(re.findall(r'(/[^\s()]+)', listing))):
    target = root / library.lstrip('/')
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(Path(library).resolve(), target)
shutil.copy2(HERE / 'init', root / 'init')
shutil.copy2(HERE / 'udev-handoff', root / 'udev-handoff')
(root / 'init').chmod(0o755)
(root / 'machine').write_text(f"ROOT_PARTUUID='{a.partuuid}'\nROOT_MAPPER='{a.mapper}'\n")
with (root / 'keymap').open('wb') as stream:
    subprocess.run(['loadkeys', '-b', a.keymap], stdout=stream, check=True)
for path in sorted(root.rglob('*')):
    if path.is_file() and not path.is_symlink() and path.read_bytes()[:4] == b'\x7fELF':
        path.chmod(0o755)
        subprocess.run(['strip', '--strip-unneeded', str(path)], check=True)
paths = ['.'] + sorted(str(path.relative_to(root)) for path in root.rglob('*'))
with (work / 'initramfs.cpio').open('wb') as stream:
    # Emit these newc entries directly: creating a device node on disk would
    # require root. The parent must precede /dev/console for kernel unpacking.
    for name, mode, major, minor in (('dev', 0o040755, 0, 0),
                                      ('dev/console', 0o020600, 5, 1)):
        filename = name.encode() + b'\0'
        fields = (0, mode, 0, 0, 1, 0, 0, 0, 0, major, minor, len(filename), 0)
        entry = b'070701' + ''.join(f'{value:08x}' for value in fields).encode() + filename
        stream.write(entry + b'\0' * (-len(entry) % 4))
    stream.flush()
    subprocess.run(['cpio', '--null', '-o', '-H', 'newc', '--owner=0:0', '--reproducible'],
                   cwd=root, input=('\0'.join(paths) + '\0').encode(), stdout=stream, check=True)
print(work / 'initramfs.cpio')
