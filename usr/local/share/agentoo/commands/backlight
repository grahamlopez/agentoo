#!/bin/sh
# Use display backlights only: acpilight otherwise falls back to other LEDs.
set -eu
usage() { python3 "$(dirname "$0")/cli.py" usage backlight; }
case "${1-}" in -h|--help) usage; exit 0 ;; esac
case "${1-}" in
    up) operation=-inc ;;
    down) operation=-dec ;;
    *) usage >&2; exit 2 ;;
esac
if [ "$#" -gt 2 ]; then
    usage >&2
    exit 2
fi
if [ "$#" -eq 2 ]; then
    case "$2" in ''|*/*|.|..) echo "Invalid backlight controller" >&2; exit 2 ;; esac
    [ -d "/sys/class/backlight/$2" ] || { echo "No display backlight: $2" >&2; exit 1; }
    controller=$2
else
    controller=
    for device in /sys/class/backlight/*; do
        [ -d "$device" ] || continue
        if [ -n "$controller" ]; then
            echo "Multiple display backlights; select a controller in host bindings" >&2
            exit 1
        fi
        controller=${device##*/}
    done
    # Desktops without a panel backlight need no action or laptop dependency.
    [ -n "$controller" ] || exit 0
fi
# Perceived scale has a minimum raw brightness of 1, rather than switching off.
exec xbacklight -ctrl "$controller" -perceived "$operation" 5
