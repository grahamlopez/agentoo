#!/bin/bash
# Install selected secret files, then discard this invocation's Proton session.
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
Usage: agentoo secrets install --profile FILE --user USER CATEGORY...

Categories are labels from the profile (for example ssh, github, wifi, pi).
Use all to select every row. Selected destination files are replaced.
Profile format: category owner destination method source
  owner: root or user; method: field, template, or github
  destination: absolute path, with HOME standing for the selected user's home
  source: pass:// reference, or an absolute template filename
EOF
}

original_args=("$@")
profile=
account=
while [[ $# -gt 0 ]]; do
    case $1 in
        --profile) profile=$2; shift 2 ;;
        --user) account=$2; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        --*) usage >&2; exit 1 ;;
        *) break ;;
    esac
done
[[ -n $profile && -n $account && $# -gt 0 ]] || { usage >&2; exit 1; }
source "$(dirname "$0")/require-root"
require_root "secrets install" bash "$0" "${original_args[@]}"
home=$(getent passwd "$account" | cut -d: -f6)
[[ -n $home ]] || { echo 'User account does not exist.' >&2; exit 1; }
group=$(id -gn "$account")

# Read data, never execute the profile as shell code.
categories=" $* "
rows=()
while read -r category owner destination method source; do
    [[ -n $category && $category != \#* ]] || continue
    [[ $categories == *' all '* || $categories == *" $category "* ]] || continue
    [[ $owner == root || $owner == user ]]
    [[ $method == field || $method == template || $method == github ]]
    destination=${destination/#HOME\//$home/}
    [[ $destination == /* && -n $source ]]
    rows+=("$owner $destination $method $source")
    printf '%s: replace %s (%s-owned, mode 0600)\n' "$category" "$destination" "$owner"
done < "$profile"
[[ ${#rows[@]} -gt 0 ]] || { echo 'No matching profile rows.' >&2; exit 1; }
read -r -p 'Install these files? [y/N] ' answer
[[ $answer == y || $answer == Y ]] || exit 0

# A separate directory keeps an existing personal CLI login untouched.
work=$(mktemp -d /run/agentoo-secrets.XXXXXX)
export PROTON_PASS_SESSION_DIR=$work/session
export PROTON_PASS_KEY_PROVIDER=fs
export PROTON_PASS_NO_UPDATE_CHECK=1
# Both session key and encrypted session stay in /run, not on the disk.
cleanup() {
    pass-cli logout >/dev/null 2>&1 || true
    rm -rf -- "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf 'Calling pass-cli...\n'
pass-cli login --interactive

for row in "${rows[@]}"; do
    read -r owner destination method source <<< "$row"
    case $method in
        field) pass-cli item view "$source" > "$work/output" ;;
        template) pass-cli inject --in-file "$source" > "$work/output" ;;
        github)
            # Git's built-in credential store expects a URL, not a bare token.
            pass-cli item view "$source/username" > "$work/username"
            pass-cli item view "$source/password" > "$work/password"
            python3 - "$work" <<'PY'
from pathlib import Path
from urllib.parse import quote
import sys
work = Path(sys.argv[1])
username = quote((work / "username").read_text().rstrip("\n"), safe="")
password = quote((work / "password").read_text().rstrip("\n"), safe="")
(work / "output").write_text(
    f"https://{username}:{password}@github.com/grahamlopez/agentoo.git\n")
PY
            ;;
    esac
    [[ -s $work/output ]]
    if [[ $owner == user ]]; then
        install -d -m 0700 -o "$account" -g "$group" "$(dirname "$destination")"
        install -m 0600 -o "$account" -g "$group" "$work/output" "$destination"
    else
        install -d -m 0755 "$(dirname "$destination")"
        install -m 0600 -o root -g root "$work/output" "$destination"
    fi
    if [[ $method == github ]]; then
        # Only the installed agentoo repository uses this credential store.
        repo=/var/lib/agentoo/repository.git
        scope=credential.https://github.com/grahamlopez/agentoo.git
        git --git-dir="$repo" config "$scope.useHttpPath" true
        git --git-dir="$repo" config --replace-all "$scope.helper" ''
        git --git-dir="$repo" config --add "$scope.helper" "store --file=$destination"
        git --git-dir="$repo" config remote.origin.pushurl https://github.com/grahamlopez/agentoo.git
    fi
    rm -f -- "$work/output"
    printf 'Installed %s\n' "$destination"
done
