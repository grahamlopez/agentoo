#!/bin/bash
# Exercise staged cryptsetup without udev, using a disposable LUKS2 loop device.
set -euo pipefail
if [[ ${1:-} != --inside ]]; then
    [[ $EUID == 0 && $# == 1 ]] || { echo "Usage: sudo $0 BUILD_DIRECTORY" >&2; exit 2; }
    exec unshare --mount --fork "$0" --inside "$(realpath "$1")"
fi
mount --make-rprivate /
build=$2
[[ -x $build/root/bin/cryptsetup && -f $build/initramfs.cpio ]] || exit 2
for tool in losetup cryptsetup mkfs.btrfs btrfs cpio mountpoint findmnt mount umount chroot udevadm blkid; do command -v "$tool" >/dev/null; done
work=$(mktemp -d /tmp/agentoo-initramfs-smoke.XXXXXXXX)
name=agentoo-smoke-${work##*.}
loop=
opened=no
cleanup() {
    set +e
    mountpoint -q "$work/root/newroot" && umount "$work/root/newroot"
    if [[ $opened == yes ]]; then cryptsetup close "$name"; fi
    for directory in sys proc run dev; do
        mountpoint -q "$work/root/$directory" && umount "$work/root/$directory"
    done
    if [[ -n $loop ]]; then losetup -d "$loop"; fi
    rm -rf "$work"
}
trap cleanup EXIT
cp -a "$build/root" "$work/root"
root=$work/root
# Extract the deliverable too, so smoke tests exercise archived ownership/contents.
(cd "$root" && cpio -idu --quiet < "$build/initramfs.cpio")
head -c 32 /dev/urandom > "$root/test.key"
chmod 600 "$root/test.key"
truncate -s 512M "$work/disk"
loop=$(losetup --find --show "$work/disk")
# Match the real root's cipher, sector size and Argon2id parameters.
cryptsetup luksFormat --batch-mode --type luks2 --cipher aes-xts-plain64 \
    --key-size 512 --sector-size 512 --pbkdf argon2id --pbkdf-memory 1048576 \
    --pbkdf-parallel 4 --pbkdf-force-iterations 4 --key-file "$root/test.key" "$loop"
mount -t tmpfs tmpfs "$root/dev"
mkdir -p "$root/dev/mapper"
for device in null random urandom; do
    read -r major minor < <(stat -c '%t %T' "/dev/$device")
    mknod "$root/dev/$device" c "$((16#$major))" "$((16#$minor))"
done
read -r major minor < <(stat -c '%t %T' /dev/mapper/control)
mknod "$root/dev/mapper/control" c "$((16#$major))" "$((16#$minor))"
read -r major minor < <(stat -c '%t %T' "$loop")
mknod "$root/dev/test-disk" b "$((16#$major))" "$((16#$minor))"
mount -t proc proc "$root/proc"
mount -t sysfs -o ro sysfs "$root/sys"
mount -t tmpfs tmpfs "$root/run"
mkdir -p "$root/run/cryptsetup"
# Fresh /run contains no udev state; don't export this into the host session.
DM_DISABLE_UDEV=1 chroot "$root" /bin/cryptsetup open --type luks2 \
    --disable-external-tokens --allow-discards --key-file /test.key /dev/test-disk "$name"
opened=yes
[[ -b $root/dev/mapper/$name ]]
mkfs.btrfs -q "$root/dev/mapper/$name"
chroot "$root" /bin/mount -t btrfs "/dev/mapper/$name" /newroot
btrfs subvolume create "$root/newroot/@"
chroot "$root" /bin/umount /newroot
chroot "$root" /bin/mount -t btrfs -o ro,subvol=@ "/dev/mapper/$name" /newroot
findmnt -no SOURCE,FSTYPE,OPTIONS --target "$root/newroot"
DM_DISABLE_UDEV=1 chroot "$root" /bin/cryptsetup status "$name"
echo 'PASS: archived cryptsetup unlocked LUKS2 without udev, created its mapping node, and BusyBox mounted Btrfs @ read-only.'

# Reproduce real-root coldplug using the host rules with fresh /run and the
# private device directory. udevadm test evaluates rules and filesystem probing;
# it does not start a daemon, emit events, execute RUN commands or start units.
[[ -f $root/udev-handoff ]] || { echo 'Rebuild the archive: missing udev-handoff helper.' >&2; exit 1; }
sys=$(readlink -f "/sys/dev/block/$(stat -c '%Hr:%Lr' "$root/dev/mapper/$name")")
read -r major minor < <(stat -c '%t %T' "$root/dev/mapper/$name")
mknod "$root/dev/${sys##*/}" b "$((16#$major))" "$((16#$minor))"
uuid=$(blkid -s UUID -o value "$root/dev/mapper/$name")
unshare --mount --fork /bin/bash -euo pipefail -c '
    root=$1; name=$2; sys=$3; uuid=$4; work=$5
    mount --make-rprivate /
    mount --bind "$root/dev" /dev
    mount --bind "$root/run" /run
    udevadm test --action=add "$sys" > "$work/coldplug-before.log" 2>&1
    if ! grep -Eq "^[[:space:]]*SYSTEMD_READY=0$" "$work/coldplug-before.log"; then
        cat "$work/coldplug-before.log"
        echo "Expected coldplug failure was not reproduced; inspect host rule behavior." >&2
        exit 1
    fi
    echo "REPRODUCED: coldplug without the handoff rule reports SYSTEMD_READY=0."
    . "$root/udev-handoff"
    prepare_udev_handoff "$name"
    udevadm verify /run/udev/rules.d/09-agentoo-initramfs-root.rules
    udevadm test --action=add "$sys" > "$work/coldplug-after.log" 2>&1
    cat "$work/coldplug-after.log" | grep -E "^[[:space:]]*(DEVLINKS|DM_NAME|DM_UDEV_PRIMARY_SOURCE_FLAG|ID_FS_UUID|SYSTEMD_READY|TAGS)=" || true
    if ! grep -Eq "^[[:space:]]*ID_FS_UUID=$uuid$" "$work/coldplug-after.log" ||
       ! grep -Fq "/dev/disk/by-uuid/$uuid" "$work/coldplug-after.log" ||
       ! grep -Eq "^[[:space:]]*TAGS=.*:systemd:" "$work/coldplug-after.log"; then
        cat "$work/coldplug-after.log"
        exit 1
    fi
    if grep -Eq "^[[:space:]]*SYSTEMD_READY=0$|^[[:space:]]*DM_UDEV_DISABLE_(DISK|OTHER)_RULES_FLAG=1$" "$work/coldplug-after.log"; then
        cat "$work/coldplug-after.log"
        exit 1
    fi
    echo "PASS: real-root udev rule evaluation probes Btrfs, requests its UUID link, and permits systemd device readiness."
' smoke-handoff "$root" "$name" "$sys" "$uuid" "$work"
