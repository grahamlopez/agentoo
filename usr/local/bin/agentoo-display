#!/usr/bin/env python3
"""Manage display output, laptop backlights, and external monitor controls."""
from pathlib import Path
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'share/agentoo/lib'))
from cli import ArgumentParser
from desktop.common import hyprctl
import display_backlight
import display_external


def build_parser():
    parser = ArgumentParser(prog='agentoo display', description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('off', help='Turn off all displays without locking',
                   description='Waits one second for key release, then turns off all displays through DPMS. '
                               'Keyboard input wakes them with Agentoo defaults.')
    display_backlight.configure_parser(sub.add_parser('backlight', help='Adjust display brightness'))
    display_external.configure_parser(sub.add_parser('external', help='Inspect and control external monitors through DDC/CI'))
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    if args.action == 'backlight':
        return display_backlight.run(args, parser)
    if args.action == 'external':
        return display_external.run(args, parser)
    # Run in the desktop user's Hyprland session. Wait for the triggering key to
    # be released so keyboard wake doesn't immediately negate a power off, then
    # blank all outputs through DPMS without locking or suspending. Keyboard
    # input wakes them because /etc/xdg/hypr/agentoo.lua sets
    # key_press_enables_dpms = true.
    time.sleep(1)
    result = hyprctl('eval', 'hl.dispatch(hl.dsp.dpms({ action = "off" }))')
    # Lua errors may be reported on stdout even when hyprctl exits successfully.
    if result != 'ok':
        raise RuntimeError(result or 'Hyprland did not acknowledge the display command')


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as error:
        print(f'agentoo display: {error}', file=sys.stderr)
        sys.exit(1)
