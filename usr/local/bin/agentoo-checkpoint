#!/bin/sh
# Recovery media can invoke the EFI implementation directly with sh.
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run agentoo-checkpoint with sudo or as root.' >&2; exit 1; }
tool=/boot/agentoo/checkpoint.sh
[ "$(findmnt -rn --uniq -o TARGET --target /boot)" = /boot ] &&
[ "$(findmnt -rn --uniq -o FSTYPE --target /boot)" = vfat ] &&
[ -f "$tool" ] || { echo 'Mount the Agentoo EFI partition at /boot first.' >&2; exit 1; }
exec sh "$tool" "$@"
