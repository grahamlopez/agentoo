#!/usr/bin/env python3
"""Inspect firmware and print EFI guidance."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'share/agentoo/lib'))
from cli import ArgumentParser
import kernel_host
import kernel_firmware

DIST_CMDLINE = Path('/etc/kernel/cmdline')


def build_parser():
    parser = ArgumentParser(prog='agentoo kernel', description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Portage owns custom gentoo-kernel builds (see /usr/local/share/agentoo/docs/kernel.md).\n'
               'Host policy comes from the selected Agentoo Portage profile.\n\n'
               'Examples:\n'
               '  agentoo kernel firmware\n'
               '  agentoo kernel firmware apply --dry-run\n'
               '  agentoo kernel gen-efi-cmd --image /boot/EFI/Gentoo/kernel-RELEASE.efi')
    sub = parser.add_subparsers(dest='operation')
    firmware = sub.add_parser('firmware', help='Show host firmware status or apply its native savedconfig',
        description='Read-only status report without sudo; use `apply` to install the host savedconfig list.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Host lists: /etc/agentoo/firmware/<host>.list\n'
               'Maintenance guide: /usr/local/share/agentoo/docs/firmware.md')
    actions = firmware.add_subparsers(dest='firmware_operation')
    apply = actions.add_parser('apply', help='Install the host list and rebuild the installed linux-firmware package',
        description='Back up overriding savedconfigs, install /etc/agentoo/firmware/<host>.list, '
                    'and rebuild the installed linux-firmware version from source (--usepkg=n).',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Backups go to /var/backups/agentoo/kernel-firmware/.\n'
               'Firmware uses -initramfs: explicitly refresh gentoo-kernel-bin and rebuild gentoo-kernel afterward.\n'
               'Exit 0: applied/planned; 1: operational error or cancelled; 2: invalid arguments.')
    apply.add_argument('--yes', action='store_true', help='accept the displayed plan')
    apply.add_argument('--dry-run', action='store_true', help='show the plan without changes')
    efi = sub.add_parser('gen-efi-cmd', help='Print an EFI registration command without changing firmware',
        description='Inspect a mounted FAT GPT ESP and print a shell-quoted create-only efibootmgr command.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Never modifies NVRAM, BootOrder, or BootNext; review and run the printed command separately.\n'
               'Binary fallback images (-gentoo-dist-bin.efi) include /etc/kernel/cmdline and their initramfs.\n'
               'Startop automatically adds --full-dev-path.')
    efi.add_argument('--image', required=True, metavar='FILE', help='installed EFI kernel image').completion = 'files'
    efi.add_argument('--args', default='', metavar='TEXT', help='extra firmware arguments; binary fallback also uses its native cmdline/initramfs')
    efi.add_argument('--label', metavar='TEXT', help='boot entry label (default: image filename without extension)')
    return parser


def notice(message):
    print(message, file=sys.stderr)


def confirm(message, yes=False, default=True):
    if yes:
        return
    if not sys.stdin.isatty():
        raise RuntimeError('confirmation needs a terminal; use --yes to accept the displayed plan')
    notice(message + (' [Y/n]?' if default else ' [y/N]?'))
    line = sys.stdin.readline()
    if not line:
        raise EOFError()
    answer = line.strip().lower()
    if answer not in ('y', 'yes') and not (not answer and default):
        raise RuntimeError('cancelled')


def authorize_sudo():
    # Start sudo's timed password prompt only when the operator is present.
    # This is separate from plan confirmation and is never skipped by --yes.
    if subprocess.run(['sudo', '-n', '-v'], stdin=subprocess.DEVNULL,
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        return
    try:
        with open('/dev/tty') as tty_in, open('/dev/tty', 'w') as tty_out:
            print('\nAdministrator authorization is needed. Press Enter when ready to enter your sudo password: ',
                  end='', file=tty_out, flush=True)
            if not tty_in.readline():
                raise EOFError()
            result = subprocess.run(['sudo', '-v'], stdin=tty_in, stdout=tty_out, stderr=tty_out)
            if result.returncode:
                raise RuntimeError('sudo authorization failed')
    except OSError as error:
        raise RuntimeError('a terminal is required to renew sudo authorization') from error


def run(command, *, capture=False, root=False, env=None, umask=-1):
    command = [str(part) for part in command]
    if root and os.geteuid() != 0:
        authorize_sudo()
        command = ['sudo', '-n', '--', *command]
    if not capture:
        notice('+ ' + shlex.join(command))
    result = subprocess.run(command, text=True, env=env, umask=umask,
                            stdout=subprocess.PIPE if capture else sys.stderr,
                            stderr=subprocess.PIPE if capture else None)
    if result.returncode:
        detail = result.stderr.strip() if capture else ''
        raise RuntimeError(f'{shlex.join(command)} exited {result.returncode}' + (f': {detail}' if detail else ''))
    return result.stdout.strip() if capture else ''


def require_tools(*names):
    missing = [name for name in names if shutil.which(name) is None]
    if missing:
        raise RuntimeError('required tools not found: ' + ', '.join(missing))


def inspect_esp(destination):
    """Resolve an image's mounted ESP, partition identity and firmware loader path."""
    ancestor = destination
    while not ancestor.exists():
        ancestor = ancestor.parent
    mounts = json.loads(run(['findmnt', '--json', '--output', 'SOURCE,TARGET,FSTYPE', '--target', ancestor], capture=True))['filesystems']
    mount = mounts[0]
    if mount['fstype'] not in ('vfat', 'fat', 'msdos'):
        raise RuntimeError(f'{destination}: expected a mounted FAT EFI System Partition, got {mount["target"]} ({mount["fstype"]})')
    source = mount['source']
    device = json.loads(run(['lsblk', '--json', '--paths', '--nodeps', '--output', 'PATH,PKNAME,PARTN,PARTUUID,PARTTYPE', source], capture=True))['blockdevices'][0]
    if str(device.get('parttype', '')).lower() != 'c12a7328-f81f-11d2-ba4b-00a0c93ec93b':
        raise RuntimeError(f'{source}: not a GPT EFI System Partition')
    if not device.get('pkname') or not device.get('partn') or not device.get('partuuid'):
        raise RuntimeError(f'cannot determine EFI disk/partition identity for {source}')
    relative = destination.relative_to(Path(mount['target']))
    loader = '\\' + str(relative).replace('/', '\\')
    return device, loader


def efi_create_command(device, loader, label, host):
    command = ['efibootmgr', '--create-only', '--disk', device['pkname'], '--part', str(device['partn']),
               '--label', label, '--loader', loader]
    if host == 'startop':
        command.insert(2, '--full-dev-path')
    return command


def gen_efi_cmd(args):
    require_tools('findmnt', 'lsblk')
    image = Path(args.image).expanduser().resolve()
    if not image.is_file():
        raise RuntimeError(f'EFI image not found: {image}')
    device, loader = inspect_esp(image)
    arguments = args.args
    if re.fullmatch(r'kernel-.+-gentoo-dist(?:-bin)?\.efi', image.name):
        initramfs = image.with_name('initramfs-' + image.name[len('kernel-'):-len('.efi')] + '.img')
        if not initramfs.is_file() or not initramfs.stat().st_size:
            raise RuntimeError(f'distribution initramfs not found or empty: {initramfs}')
        cmdline = DIST_CMDLINE.read_text().strip()
        if not cmdline:
            raise RuntimeError(f'distribution kernel command line is empty: {DIST_CMDLINE}')
        initrd = loader.rsplit('\\', 1)[0] + '\\' + initramfs.name
        arguments = f'{cmdline} initrd={initrd}' + (f' {arguments}' if arguments else '')
        notice(f'Distribution boot inputs: {DIST_CMDLINE} and {initramfs}')
    command = efi_create_command(device, loader, args.label if args.label is not None else image.stem,
                                 kernel_host.selected_host())
    if arguments:
        command.extend(['--unicode', '--', arguments])
    notice('Running this command creates an entry without changing BootOrder or BootNext.')
    notice('Firmware arguments supplement the embedded kernel command line; repeated parameters have parameter-specific behavior.')
    print(shlex.join(['sudo', *command]))


def main():
    parser = build_parser()
    args = parser.parse_args()
    if args.operation is None:
        parser.print_help()
        return 0
    try:
        if args.operation == 'firmware':
            state = kernel_firmware.inspect()
            if args.firmware_operation == 'apply':
                kernel_firmware.apply(args, state, run=run, confirm=confirm, notice=notice)
            else:
                kernel_firmware.show_status(state)
        else:
            gen_efi_cmd(args)
        return 0
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        notice(f'agentoo kernel: {error}')
        return 1
    except (KeyboardInterrupt, EOFError):
        notice('agentoo kernel: cancelled')
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
