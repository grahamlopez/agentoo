#!/usr/bin/env python3
"""Dispatch Agentoo commands. CLI policy: ../share/agentoo/lib/cli.py.

Do not parse command arguments or perform privileged work here. Use fixed paths,
not PATH plugin discovery. Each executable owns its help and validation.
"""
import difflib
import importlib.util
import os
from pathlib import Path
import sys
import subprocess

sys.dont_write_bytecode = True
BIN = Path(__file__).resolve().parent
SHARE = BIN.parent / 'share/agentoo'
sys.path.insert(0, str(SHARE / 'lib'))
from paths import SYSTEM_GIT_DIR
spec = importlib.util.spec_from_file_location('agentoo_completion', SHARE / 'lib/completion.py')
completion = importlib.util.module_from_spec(spec)
spec.loader.exec_module(completion)
COMMANDS = completion.COMMANDS


def usage(file=None):
    print('Usage: agentoo <command> [options]\n', file=file)
    print('Manage Agentoo system configuration and desktop utilities.\n', file=file)
    for name, description in COMMANDS.items():
        print(f'  {name:<12} {description}', file=file)
    print("\nExamples:\n  agentoo power\n  agentoo fonts doctor\n  agentoo git status", file=file)
    print("\nRun 'agentoo help COMMAND [SUBCOMMAND]' for details.", file=file)
    print('Documentation: /usr/local/share/agentoo/docs/', file=file)


def main():
    args = sys.argv[1:]
    if args and args[0] == '__complete':
        os.execv(sys.executable, [sys.executable, str(SHARE / 'lib/completion.py'), 'complete', *args[1:]])
    if args and args[0] == 'help':
        args = [*args[1:], '--help'] if len(args) > 1 else []
    if not args or args[0] in ('-h', '--help'):
        usage()
        return
    if args == ['--version']:
        checkout_git = BIN.parents[2] / '.git' if len(BIN.parents) > 2 else Path('/nonexistent/.git')
        git_dir = checkout_git if checkout_git.exists() else SYSTEM_GIT_DIR
        try:
            revision = subprocess.run(['git', '--git-dir', str(git_dir), 'rev-parse', '--short', 'HEAD'],
                                      text=True, capture_output=True, check=True, timeout=2).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            revision = 'unavailable'
        print(f'agentoo (repository revision: {revision})')
        return
    name = args[0]
    if name not in COMMANDS or name == 'help':
        print(f"agentoo: unknown command: {name} (see 'agentoo --help')", file=sys.stderr)
        suggestion = difflib.get_close_matches(name, COMMANDS, n=1)
        if suggestion:
            print(f"Did you mean '{suggestion[0]}'?", file=sys.stderr)
        print(file=sys.stderr)
        usage(file=sys.stderr)
        raise SystemExit(2)
    executable = BIN / ('agentoo-' + name)
    os.execv(str(executable), [str(executable), *args[1:]])


if __name__ == '__main__':
    main()
