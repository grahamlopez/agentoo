#!/usr/bin/env bash
set -Eeuo pipefail

readonly commands=/usr/local/share/agentoo/commands
usage() {
    python3 "$commands/cli.py" usage agentoo
    cat <<'HELP'

Manage Agentoo system configuration and desktop utilities.

Commands:
HELP
    python3 "$commands/cli.py" commands
    cat <<'HELP'

Repository:
  git [<git-options>] <command> [args...]
                         Run a Git command against the system repository
  git setup-hooks        Enable permission management hooks
  git enable-write       Switch origin to SSH for fetch and push

Checkpoints:
  checkpoint create LABEL
                         Capture system, home, and EFI
  checkpoint list        List checkpoints and storage usage
  checkpoint inspect NAME
                         Show metadata and verify saved components
  checkpoint restore NAME --device DEVICE
                         Restore from recovery media; preserve home by default

Permissions:
  permissions check      Report ownership and permission mismatches
  permissions fix        Restore declared ownership and permissions

Secrets:
  secrets install --profile FILE --user USER CATEGORY...
                         Install selected categories; use "all" for every row

Desktop and power:
  backlight {up|down} [CONTROLLER]
                         Adjust perceived brightness by 5%
  screenshot {full|region}
                         Save a capture under ~/Downloads/Screenshots
  power                  Show charge, battery wattage, and estimated runtime
  power show-all         Show detailed battery and CPU power settings

Fonts:
  fonts [status] [--filter TEXT] [--nerd]
                         Show current Kitty settings and installed families/styles
  fonts test [SUITE]      Print samples with the current terminal's rendering
  fonts test [SUITE] --font FAMILY
                         Adjust a font in a dedicated Kitty preview; --interactive uses current settings
  fonts test [SUITE] --target firefox
                         Open a read-only browser comparison
  fonts set [--font FAMILY]
                         Choose interactively, or apply an explicit selection
  fonts set --restore TEXT
                         Restore an exact fragment from a printed revert command
  fonts doctor [--text TEXT] [--font PATTERN] [--suite SUITE] [--json]
                         Inspect codepoints, single-face/system coverage, matching, and policy
  fonts doctor --render  Open a fresh Kitty diagnostic window with fallback tracing
  fonts <subcommand> --help
                         Explain arguments and options
  Font agent guide: /usr/local/share/agentoo/docs/fonts.md

Options:
  -h, --help             Show help

Examples:
  agentoo git status
  sudo agentoo checkpoint create before-upgrade
  sudo agentoo checkpoint list
  agentoo permissions check
  sudo agentoo permissions fix
  sudo agentoo secrets install --profile FILE --user graham ssh github

Operations request sudo only when needed. Arbitrary Git commands run as the
current user; use sudo explicitly for protected repository writes.
Secret installation confirms file replacement.

Run 'agentoo help <command>' or 'agentoo <command> --help' for details.
HELP
}
fail() { printf 'agentoo: %s\n' "$*" >&2; exit 2; }

# Completion is handled before dispatch and privilege checks.
if [[ ${1:-} == __complete ]]; then
    shift
    exec python3 "$commands/cli.py" complete "$@"
fi

# Normalize help before any privilege check. Never inspect forwarded Git arguments.
if [[ ${1:-} == help ]]; then
    shift
    if (( $# == 0 )); then usage; exit 0; fi
    (( $# == 1 )) || fail 'usage: agentoo help [command]'
    set -- "$1" --help
fi
case ${1:-} in
    ''|-h|--help) usage; exit 0 ;;
    git|checkpoint|permissions|secrets|backlight|screenshot|power|fonts) command=$1; shift ;;
    *) fail "unknown command: $1 (see 'agentoo --help')" ;;
esac

case $command in
    git)
        if (( $# == 0 )) || [[ ${1:-} == -h || ${1:-} == --help ]]; then
            python3 "$commands/cli.py" usage git
            printf '       agentoo git {setup-hooks|enable-write}\n\nRuns Git against /var/lib/agentoo/repository.git with work tree /.\nOther Git arguments are forwarded unchanged.\n'
            exit 0
        fi
        ;;
    checkpoint)
        case ${1:-} in
            ''|-h|--help) exec sh /boot/agentoo/checkpoint.sh --help ;;
            create|list|inspect|restore)
                if [[ ${2:-} == -h || ${2:-} == --help ]]; then
                    exec sh /boot/agentoo/checkpoint.sh --help
                fi ;;
            *) fail "unknown checkpoint command: $1" ;;
        esac
        ;;
    permissions)
        if [[ ${2:-} == -h || ${2:-} == --help ]]; then set -- --help; fi
        case ${1:-} in
            ''|-h|--help)
                python3 "$commands/cli.py" usage permissions
                printf '\ncheck reports mismatches; fix restores ownership and modes. Both request sudo when needed.\n--root selects a mounted target root (default: /).\n'
                exit 0 ;;
            check) python3 "$commands/cli.py" validate permissions "$@"; shift; set -- --check "$@" ;;
            fix) python3 "$commands/cli.py" validate permissions "$@"; shift; set -- --fix "$@" ;;
            *) fail "unknown permissions command: $1" ;;
        esac
        ;;
    secrets)
        case ${1:-} in
            ''|-h|--help) exec bash "$commands/secrets" --help ;;
            install) shift ;;
            *) fail "unknown secrets command: $1" ;;
        esac
        ;;
esac

case $command in
    permissions) exec python3 "$commands/permissions.py" "$@" ;;
    fonts) exec python3 "$commands/fonts.py" "$@" ;;
    power) exec python3 "$commands/power.py" "$@" ;;
    *)
        case $command in
            checkpoint|secrets|backlight|screenshot)
                python3 "$commands/cli.py" validate "$command" "$@" ;;
        esac
        exec bash "$commands/$command" "$@" ;;
esac
