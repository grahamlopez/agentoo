#!/usr/bin/env python3
"""Compatibility entry point for agentoo display backlight."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'share/agentoo'))
from display_backlight import build_parser, main


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as error:
        print(f'agentoo display backlight: {error}', file=sys.stderr)
        sys.exit(1)
