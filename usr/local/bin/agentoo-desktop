#!/usr/bin/env python3
"""Manage personal desktop preferences."""
import argparse
from pathlib import Path
import signal
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'share/agentoo/lib'))
from cli import ArgumentParser
from desktop.common import atomic_write


def build_parser():
    parser = ArgumentParser(prog='agentoo desktop', description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Changes apply immediately and persist across sessions.\n'
               'Run a feature without an action to show its current settings.\n'
               'set --file applies appearance settings only; clear includes wallpaper.\n\n'
               'Examples:\n'
               '  agentoo desktop set --file appearance.json\n'
               '  agentoo desktop transparency set --focused 5 --unfocused 10\n'
               '  agentoo desktop blur clear --window kitty\n'
               '  agentoo desktop clear\n\n'
               'Exit 0: success; 1: operational failure; 2: invalid arguments.')
    from desktop.state import file_option, window_option
    parser.set_defaults(action=None, appearance_file=None, window='all')
    commands = parser.add_subparsers(dest='command', prog=parser.prog)
    setter = commands.add_parser('set', help='Apply and remember appearance settings from JSON',
        description='Apply and remember appearance settings. Omitted settings stay unchanged. Wallpaper is separate.')
    setter.set_defaults(command=None, action='set')
    file_option(setter, required=True)
    clear = commands.add_parser('clear', help='Clear all desktop preferences, including wallpaper',
        description='Remove all appearance overrides, apply configured defaults, and forget and stop the managed wallpaper.')
    clear.set_defaults(command=None, action='clear')
    wallpaper = commands.add_parser('wallpaper', help='Show or change the static wallpaper',
        description='Print the remembered absolute image path; print nothing if none is selected.',
        epilog='One image fills all monitors. Images stay in place. Collection: /usr/local/share/agentoo/wallpapers/.')
    actions = wallpaper.add_subparsers(dest='action', prog=wallpaper.prog)
    image = actions.add_parser('set', help='Apply and remember an image')
    image.add_argument('file', metavar='FILE', help='Readable image file').completion = 'files'
    actions.add_parser('clear', help='Forget the image and stop the managed wallpaper',
                       description='Forget the selected image and stop the managed wallpaper.')
    transparency = commands.add_parser('transparency', help='Show or change window transparency',
        description='Without an action, show current transparency settings.\n'
                    '--window selects the category to show, set, or clear.\n'
                    'It may appear before or after the action.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='Kitty uses background-only transparency; other windows fade text too.\n'
               'Floating windows, dialogs, fullscreen windows and the Kitty dropdown are included.\n'
               'Panels, menus and notifications are excluded.\n'
               'Kitty processes started before integration was installed need a restart.\n\n'
               'Examples:\n'
               '  agentoo desktop transparency --window kitty\n'
               '  agentoo desktop transparency set --window kitty --focused 5\n'
               '  agentoo desktop transparency clear --window kitty')
    window_option(transparency)
    actions = transparency.add_subparsers(dest='action')
    setter = actions.add_parser('set', help='Apply and remember transparency settings',
        description='Apply and remember transparency. Omitted settings stay unchanged.',
        epilog='0 means fully opaque. Setting all clears category overrides for supplied focus states. '
               'Kitty/browser/other overrides take precedence over shared values. '
               'Supply at least one adjustment or --file; --file cannot accompany adjustments '
               'or a kitty/browser/other window category.')
    window_option(setter, child=True)
    from desktop.transparency import percentage
    setter.add_argument('--focused', type=percentage, metavar='PERCENT', help='Focused-window transparency, 0–90')
    setter.add_argument('--unfocused', type=percentage, metavar='PERCENT', help='Unfocused-window transparency, 0–90')
    file_option(setter)
    clear = actions.add_parser('clear', help='Remove saved transparency overrides',
        description='Remove saved transparency overrides and apply configured defaults. '
                    'Clearing kitty/browser/other restores inheritance; all clears shared and category overrides.')
    window_option(clear, child=True)
    from desktop.blur import add_parser
    add_parser(commands)
    from desktop.effects import add_parsers
    add_parsers(commands)
    return parser


def main():
    from desktop.state import update, state_path
    from desktop import wallpaper as wallpaper
    from desktop import blur as blur
    from desktop import transparency as transparency
    from desktop import effects as effects

    parser = build_parser()
    args = parser.parse_args()
    directory = state_path().parent
    if args.command == 'wallpaper':
        return wallpaper.run(args)
    if args.command is None and args.action is None:
        parser.print_help()
        return 0
    if args.command == 'blur':
        blur.validate(args, parser)
        if args.diagnose:
            return blur.diagnose(directory / 'appearance.json', args.window)
    if args.action is None:
        if args.command == 'blur':
            return blur.query(directory / 'appearance.json', args.window)
        if args.command == 'transparency':
            transparency.show(transparency.read_state(directory / 'appearance.json'), args.window)
        else:
            effects.show(effects.read_state(directory / 'appearance.json', selected=args.command), args.command)
        return 0
    if args.action == 'set' and args.command is not None:
        values = {
            key: value for key, value in vars(args).items()
            if key not in ('command', 'action', 'window', 'diagnose', 'appearance_file') and value is not None}
        if args.appearance_file is not None and (values or args.window != 'all'):
            parser.error('--file cannot accompany adjustments or a kitty/browser/other window category')
        if not values and args.appearance_file is None:
            parser.error('set requires at least one adjustment or --file')
    update(args, directory, atomic_write, parser)
    if args.command is None and args.action == 'clear':
        return wallpaper.run(args)
    return 0


if __name__ == '__main__':
    def interrupted(number, _frame):
        raise SystemExit(128 + number)

    signal.signal(signal.SIGTERM, interrupted)
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError) as error:
        print(f'agentoo desktop: {error}', file=sys.stderr)
        raise SystemExit(1)
