#!/usr/bin/env python3
"""Check or restore ownership and modes of explicitly managed agentoo files."""
import argparse
import os
from pathlib import Path, PurePosixPath
import stat
import subprocess
import sys

POLICY = "etc/agentoo/permissions.conf"


def safe_file(root, relative):
    path = root
    for component in PurePosixPath(relative).parts:
        path = path / component
        if path.is_symlink():
            raise ValueError(f"refusing symlink: {path}")
    if not path.is_file():
        raise ValueError(f"missing or nonregular file: {path}")
    return path


def load_policy(root):
    entries = {}
    for number, line in enumerate(safe_file(root, POLICY).read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        if len(fields) != 4:
            raise ValueError(f"{POLICY}:{number}: expected path uid gid mode")
        relative, uid, gid, mode = fields
        parts = PurePosixPath(relative).parts
        if not parts or relative.startswith("/") or ".." in parts or relative in entries:
            raise ValueError(f"{POLICY}:{number}: invalid or duplicate path")
        if len(mode) != 4 or any(c not in "01234567" for c in mode):
            raise ValueError(f"{POLICY}:{number}: invalid mode")
        uid, gid, mode = int(uid), int(gid), int(mode, 8)
        if uid < 0 or gid < 0 or mode & 0o7000:
            raise ValueError(f"{POLICY}:{number}: invalid owner or special mode")
        entries[relative] = (uid, gid, mode)
    if POLICY not in entries:
        raise ValueError("permissions policy must include itself")
    return entries


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--check", action="store_true", help="report only (default)")
    modes.add_argument("--fix", action="store_true", help="restore declared ownership and modes")
    parser.add_argument("--root", default="/", help="mounted target root (default: /)")
    args = parser.parse_args()
    root = Path(args.root).resolve(strict=True)
    if not root.is_dir():
        parser.error("target root must be a directory")
    if args.fix and os.geteuid() != 0:
        parser.error("--fix requires root; no automatic elevation is performed")
    entries = load_policy(root)
    problems = []
    changes = []
    # Validate all paths before changing anything. Never recurse or follow links.
    for relative, expected in entries.items():
        try:
            path = safe_file(root, relative)
            current = path.stat()
            actual = (current.st_uid, current.st_gid, stat.S_IMODE(current.st_mode))
            if actual != expected:
                changes.append((path, expected))
                print(f"MISMATCH /{relative}: {actual[0]}:{actual[1]} {actual[2]:04o}"
                      f" -> {expected[0]}:{expected[1]} {expected[2]:04o}")
        except (ValueError, OSError) as error:
            problems.append(str(error))
    git_dir = root / "var/lib/agentoo/repository.git"
    if git_dir.is_dir():
        result = subprocess.run(
            ["git", f"--git-dir={git_dir}", f"--work-tree={root}",
             "-C", str(root), "ls-files", "-z"],
            check=True, stdout=subprocess.PIPE)
        tracked = set(os.fsdecode(result.stdout).rstrip("\0").split("\0")) - {""}
        for relative in sorted(tracked - entries.keys()):
            problems.append(f"no permission policy for tracked file: /{relative}")
    if problems:
        for problem in problems:
            print(f"ERROR {problem}", file=sys.stderr)
        print("No permissions changed: resolve policy/path errors first.", file=sys.stderr)
        return 1
    if args.fix:
        for path, (uid, gid, mode) in changes:
            # Open without following a substituted symlink; change the opened file.
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            try:
                if not stat.S_ISREG(os.fstat(fd).st_mode):
                    raise ValueError(f"refusing nonregular file: {path}")
                os.fchown(fd, uid, gid)
                os.fchmod(fd, mode)
            finally:
                os.close(fd)
        print(f"Permissions: {len(changes)} corrected; {len(entries)} files checked.")
        return 0
    print(f"Permissions: {len(changes)} mismatches; {len(entries)} files checked.")
    return int(bool(changes))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"ERROR {error}", file=sys.stderr)
        sys.exit(1)
