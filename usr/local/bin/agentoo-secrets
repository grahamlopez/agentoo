#!/usr/bin/env python3
"""Install trusted profile files; CLI policy: ../share/agentoo/lib/cli.py.

Authentication uses an isolated interactive /run filesystem session, erased
on exit.
Profiles and destinations are trusted administrator inputs, not a sandbox.
"""
import os
from pathlib import Path
import pwd
import shutil
import signal
import subprocess
import sys
import tempfile
from urllib.parse import quote_from_bytes

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'share/agentoo/lib'))
from cli import ArgumentParser
from paths import SYSTEM_GIT_DIR


def build_parser():
    parser = ArgumentParser(prog='agentoo secrets', description='Install secret files from Proton Pass using a trusted profile.')
    sub = parser.add_subparsers(dest='operation', required=True)
    install = sub.add_parser('install', help='Replace files selected by profile categories',
                             description='Replace selected destination files (mode 0600). Authentication requires an interactive terminal.',
                             epilog='Profile: category owner destination method source. Owners: root/user. Methods: field/template/github. HOME/ uses the selected user home. Example: agentoo secrets install --profile /etc/agentoo/secrets/qemu.conf --user graham github')
    install.add_argument('--profile', required=True, metavar='FILE', help='Trusted profile file').completion = 'files'
    install.add_argument('--user', required=True, metavar='USER', help='Existing destination user').completion = 'users'
    install.add_argument('--dry-run', action='store_true', help='Validate inputs and print the plan without authentication or writes')
    install.add_argument('--yes', action='store_true', help='Confirm replacement of selected files')
    install.add_argument('--no-input', action='store_true', help='Never prompt; supported only with --dry-run')
    install.add_argument('category', nargs='+', metavar='CATEGORY', help='Profile labels, or all').completion = 'categories'
    return parser


def read_plan(profile, account, categories):
    try:
        user = pwd.getpwnam(account)
    except KeyError:
        raise ValueError('User account does not exist.') from None
    rows = []
    known = set()
    try:
        handle = open(profile)
    except PermissionError:
        raise  # Let main retry through sudo.
    except OSError as error:
        raise ValueError(f'Cannot open profile file {profile!r}: {error.strerror}. '
                         '--profile expects a local file, not a Proton vault name.') from None
    with handle:
        for number, line in enumerate(handle, 1):
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            parts = line.split(None, 4)
            if len(parts) != 5:
                raise ValueError(f'Invalid profile row {number}: expected five fields.')
            category, owner, destination, method, source = parts
            source = source.rstrip('\r\n')
            known.add(category)
            if category not in categories and 'all' not in categories:
                continue
            if destination.startswith('HOME/'):
                destination = str(Path(user.pw_dir) / destination[5:])
            if owner not in ('root', 'user') or method not in ('field', 'template', 'github'):
                raise ValueError(f'Invalid owner or method in profile row {number}.')
            if not Path(destination).is_absolute() or Path(destination).name in ('', '.', '..'):
                raise ValueError(f'Invalid destination in profile row {number}.')
            if method == 'template':
                if not Path(source).is_absolute() or not Path(source).is_file():
                    raise ValueError(f'Profile row {number} requires a readable absolute template file.')
                with open(source, 'rb'):
                    pass
            elif not source.startswith('pass://'):
                raise ValueError(f'Profile row {number} requires a pass:// reference.')
            rows.append((category, owner, destination, method, source))
    unknown = set(categories) - known - {'all'}
    if unknown:
        raise ValueError('Unknown categories: ' + ', '.join(sorted(unknown)))
    if not rows:
        raise ValueError('No matching profile rows.')
    return user, rows


def proton_environment(session):
    env = {key: value for key, value in os.environ.items() if not key.startswith('PROTON_PASS_')}
    env.update(PROTON_PASS_SESSION_DIR=str(session), PROTON_PASS_KEY_PROVIDER='fs',
               PROTON_PASS_NO_UPDATE_CHECK='1')
    return env


def run_proton(args, env, *, interactive=False, timeout=60):
    # Secret stdout and provider diagnostics never appear in our error messages.
    try:
        process = subprocess.Popen(['pass-cli', *args], env=env,
                                   stdin=None if interactive else subprocess.DEVNULL,
                                   stdout=sys.stderr if interactive else subprocess.PIPE,
                                   stderr=None if interactive else subprocess.PIPE)
        try:
            output, _ = process.communicate(timeout=None if interactive else timeout)
            if process.returncode:
                raise subprocess.CalledProcessError(process.returncode, 'pass-cli')
        except BaseException:
            # Cancellation must not wait indefinitely on an interactive provider.
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=1)
            for stream in (process.stdout, process.stderr):
                if stream:
                    stream.close()
            raise
    except (OSError, subprocess.SubprocessError):
        raise ValueError(f'Proton Pass {args[0]} failed; check authentication and the selected reference.') from None
    return output


def install_file(destination, content, uid, gid):
    # Preserve install(1) parent ownership/modes and file replacement semantics.
    parent = Path(destination).parent
    parent.mkdir(parents=True, exist_ok=True)
    os.chmod(parent, 0o700 if uid else 0o755)
    os.chown(parent, uid, gid)
    fd, temporary = tempfile.mkstemp(prefix='.agentoo-secret-', dir=parent)
    try:
        with os.fdopen(fd, 'wb') as handle:
            handle.write(content)
            os.fchmod(handle.fileno(), 0o600)
            os.fchown(handle.fileno(), uid, gid)
        os.replace(temporary, destination)
    finally:
        Path(temporary).unlink(missing_ok=True)


def perform(user, rows):
    work = None
    env = None
    try:
        work = tempfile.mkdtemp(prefix='agentoo-secrets.', dir='/run')
        env = proton_environment(Path(work) / 'session')
        print('Calling pass-cli interactive login...', file=sys.stderr)
        run_proton(['login', '--interactive'], env, interactive=True)
        for category, owner, destination, method, source in rows:
            print(f'{category}: retrieving content for {destination}', file=sys.stderr)
            if method == 'template':
                content = run_proton(['inject', '--in-file', source], env)
            elif method == 'github':
                username = run_proton(['item', 'view', source + '/username'], env).rstrip(b'\n')
                password = run_proton(['item', 'view', source + '/password'], env).rstrip(b'\n')
                content = f'https://{quote_from_bytes(username, safe="")}:{quote_from_bytes(password, safe="")}@github.com/grahamlopez/agentoo.git\n'.encode()
            else:
                content = run_proton(['item', 'view', source], env)
            if not content:
                raise ValueError('Proton Pass returned empty content; installation stopped.')
            print(f'{category}: writing {destination}', file=sys.stderr)
            install_file(destination, content, user.pw_uid if owner == 'user' else 0,
                         user.pw_gid if owner == 'user' else 0)
            if method == 'github':
                print('Configuring Agentoo Git credentials...', file=sys.stderr)
                scope = 'credential.https://github.com/grahamlopez/agentoo.git'
                for arguments in ((scope + '.useHttpPath', 'true'), ('--replace-all', scope + '.helper', ''),
                                  ('--add', scope + '.helper', 'store --file=' + destination),
                                  ('remote.origin.pushurl', 'https://github.com/grahamlopez/agentoo.git')):
                    subprocess.run(['git', f'--git-dir={SYSTEM_GIT_DIR}', 'config', *arguments],
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, check=True, timeout=15)
            print(f'Installed {destination}', file=sys.stderr)
    finally:
        if work:
            try:
                run_proton(['logout'], env, timeout=10)
            except ValueError:
                print('Warning: temporary Proton logout failed; removing the local session.', file=sys.stderr)
            shutil.rmtree(work)


def elevate(tokens, no_input):
    command = ['sudo', *(['-n'] if no_input else []), '--', sys.executable,
               str(Path(__file__).resolve()), *tokens]
    os.execvp(command[0], command)


def main(argv=None):
    tokens = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    if not tokens:
        parser.print_help()
        return 0
    before_boundary = tokens[:tokens.index('--')] if '--' in tokens else tokens
    if tokens and tokens[0] == 'install' and not any(token in ('-h', '--help') for token in before_boundary):
        # argparse cannot intermix a variable-length positional across subparsers.
        # Select the one verb, then let its authoritative parser handle ordering.
        install = next(action for action in parser._actions if hasattr(action, 'choices') and isinstance(action.choices, dict)).choices['install']
        args = install.parse_intermixed_args(tokens[1:])
    else:
        args = parser.parse_args(tokens)
    os.umask(0o077)
    try:
        if args.no_input and not args.dry_run:
            raise ValueError('--no-input supports only --dry-run; installation requires interactive Proton login.')
        if not args.dry_run and not sys.stdin.isatty():
            raise ValueError('Interactive Proton login needs a terminal.')
        try:
            user, rows = read_plan(args.profile, args.user, args.category)
        except PermissionError:
            if os.geteuid() != 0:
                elevate(tokens, args.no_input)
                return 1  # exec never returns
            raise
        for category, owner, destination, _, _ in rows:
            print(f'{category}: replace {destination} ({owner}-owned, mode 0600)', file=sys.stderr)
        if args.dry_run:
            return 0
        if os.geteuid() != 0:
            elevate(tokens, args.no_input)
            return 1  # exec never returns
        if not args.yes:
            if not sys.stdin.isatty():
                raise ValueError('Confirmation needs a terminal; use --yes to confirm explicitly.')
            print('Install these files? [y/N] ', end='', file=sys.stderr, flush=True)
            if input().strip() not in ('y', 'Y'):
                return 0
        def interrupted(signum, _frame):
            raise SystemExit(128 + signum)
        signal.signal(signal.SIGINT, interrupted)
        signal.signal(signal.SIGTERM, interrupted)
        perform(user, rows)
        return 0
    except KeyboardInterrupt:
        print('agentoo secrets: cancelled.', file=sys.stderr)
        return 130
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        # OS/provider diagnostics can include secret content: expose no raw provider errors.
        message = str(error) if isinstance(error, ValueError) else 'Operation failed; check inputs, permissions, and dependencies. Partial installs may remain.'
        print('agentoo secrets: ' + message, file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
