#!/usr/bin/env bash
set -Eeuo pipefail

readonly GIT_DIR=/var/lib/agentoo/repository.git
readonly WORK_TREE=/
readonly SSH_REMOTE=git@github.com:grahamlopez/agentoo.git

if [[ $# -gt 0 ]] && (( EUID != 0 )); then
  printf 'Agentoo manages root-owned system configuration; requesting sudo authorization.\n' >&2
  exec sudo -- /usr/local/bin/agentoo-git "$@"
fi

git_config() {
  git --git-dir="$GIT_DIR" --work-tree="$WORK_TREE" "$@"
}

case ${1:-} in
  setup-hooks)
    (( EUID == 0 )) || { printf 'setup-hooks requires root\n' >&2; exit 1; }
    [[ $(git_config rev-parse --show-toplevel) == / ]] || exit 1
    hooks=/usr/local/share/agentoo/git-hooks
    for hook in pre-commit post-checkout post-merge post-rewrite; do
      [[ -x $hooks/$hook ]] || { printf 'missing hook: %s\n' "$hooks/$hook" >&2; exit 1; }
    done
    existing=$(git_config config --get core.hooksPath || true)
    [[ -z $existing || $existing == "$hooks" ]] \
      || { printf 'refusing to replace existing hooksPath: %s\n' "$existing" >&2; exit 1; }
    /usr/local/bin/agentoo-permissions --fix
    git_config config core.hooksPath "$hooks"
    printf 'agentoo permission hooks enabled.\n'
    ;;
  enable-write)
    git_config remote set-url origin "$SSH_REMOTE"
    printf 'origin now uses SSH for fetch and push: %s\n' "$SSH_REMOTE"
    ;;
  git)
    shift
    git_config "$@"
    ;;
  '')
    printf 'usage: agentoo-git [git options] <git command or alias> [arguments...]\n       agentoo-git {enable-write|setup-hooks}\n' >&2
    exit 2
    ;;
  *)
    git_config "$@"
    ;;
esac
