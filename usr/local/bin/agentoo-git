#!/usr/bin/env python3
"""Run Git against Agentoo's system repository, preserving Git arguments verbatim.

Only enable-write is an Agentoo operation. Its options are never interpreted in
forwarded Git arguments; an initial `git` explicitly forwards.
"""
import os
from pathlib import Path
import shlex
import stat
import subprocess
import sys

sys.dont_write_bytecode = True
SHARE = Path(__file__).resolve().parent.parent / 'share/agentoo'
sys.path.insert(0, str(SHARE / 'lib'))
from cli import ArgumentParser
from paths import SYSTEM_GIT_DIR, SYSTEM_WORK_TREE

SSH_REMOTE = 'git@github.com:grahamlopez/agentoo.git'
GUARD_BYPASS = {'status', 'diff', 'log', 'show', 'blame', 'grep', 'ls-files', 'ls-tree',
                'rev-parse', 'rev-list', 'describe', 'config', 'remote', 'fetch', 'push',
                'help', '--help', '--version'}
READ_ONLY_COMMANDS = {
    'status', 'diff', 'log', 'show', 'blame', 'grep', 'ls-files', 'ls-tree',
    'rev-parse', 'rev-list', 'describe', 'shortlog', 'cat-file', 'show-ref',
    'for-each-ref', 'name-rev', 'merge-base', 'diff-tree', 'diff-files',
    'diff-index', 'help', 'version',
}
GLOBAL_VALUE_OPTIONS = {
    '-c', '-C', '--git-dir', '--work-tree', '--namespace', '--config-env',
    '--super-prefix', '--list-cmds',
}
BRANCH_WRITE_LONG = {'--delete', '--move', '--copy', '--force', '--set-upstream-to',
                     '--unset-upstream', '--edit-description', '--create-reflog',
                     '--track', '--no-track'}
TAG_WRITE_LONG = {'--annotate', '--sign', '--local-user', '--delete', '--force',
                  '--message', '--file'}
CONFIG_READ_FLAGS = {'-l', '--list', '--get', '--get-all', '--get-regexp', '--get-urlmatch'}
CONFIG_WRITE_FLAGS = {'--add', '--replace-all', '--unset', '--unset-all',
                      '--rename-section', '--remove-section', '-e', '--edit'}


def build_parser():
    parser = ArgumentParser(prog='agentoo git', description=__doc__,
                            epilog='Other arguments are passed unchanged to Git. Use `agentoo git git ...` '
                                   'to explicitly forward an Agentoo operation name to Git.')
    sub = parser.add_subparsers(dest='operation', required=True)
    child = sub.add_parser('enable-write', help='Switch origin fetch/push URL to SSH',
                           description='Switch origin fetch/push URL to SSH')
    child.add_argument('--no-input', action='store_true', help='Use sudo without prompting (sudo -n)')
    return parser


def split_git_command(args):
    """Return (subcommand, rest) after skipping leading Git global options."""
    index = 0
    while index < len(args):
        token = args[index]
        if token in ('-h', '--help', '-v', '--version'):
            return token, args[index + 1:]
        if token in GLOBAL_VALUE_OPTIONS:
            index += 2
            continue
        if token.startswith('-'):
            index += 1
            continue
        return token, args[index + 1:]
    return None, []


def options_before_terminator(tokens):
    return tokens[:tokens.index('--')] if '--' in tokens else tokens


def is_help_or_version(args):
    subcommand, rest = split_git_command(args)
    if subcommand in (None, '-h', '--help', '-v', '--version', 'help', 'version'):
        return True
    before = options_before_terminator(rest)
    return '-h' in before or '--help' in before


def has_option(tokens, short_letters, long_options):
    for token in options_before_terminator(tokens):
        if token.startswith('--'):
            if token.split('=', 1)[0] in long_options:
                return True
        elif token.startswith('-') and len(token) > 1 and set(token[1:]) & short_letters:
            return True
    return False


def first_positional(tokens):
    for token in options_before_terminator(tokens):
        if not token.startswith('-'):
            return token
    return None


def expand_alias(name):
    """Resolve one Git alias via native config; ignore shell aliases (!...)."""
    try:
        result = subprocess.run(
            ['git', f'--git-dir={SYSTEM_GIT_DIR}', 'config', '--get', f'alias.{name}'],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    if not value or value.startswith('!'):
        return None
    try:
        return shlex.split(value)
    except ValueError:
        return None


def is_read_only_command(args, resolve_alias=True):
    if is_help_or_version(args):
        return True
    subcommand, rest = split_git_command(args)
    if subcommand in READ_ONLY_COMMANDS:
        return True
    before = options_before_terminator(rest)
    if subcommand == 'branch':
        if has_option(before, set('dDmMcCfut'), BRANCH_WRITE_LONG):
            return False
        return '-l' in before or '--list' in before or first_positional(before) is None
    if subcommand == 'tag':
        if has_option(before, set('asudfmF'), TAG_WRITE_LONG):
            return False
        return (any(flag in before for flag in ('-l', '--list', '-v', '--verify'))
                or first_positional(before) is None)
    if subcommand == 'remote':
        return first_positional(before) in (None, 'show', 'get-url')
    if subcommand == 'config':
        if has_option(before, set('e'), CONFIG_WRITE_FLAGS):
            return False
        return (any(token.split('=', 1)[0] in CONFIG_READ_FLAGS for token in before)
                or first_positional(before) in ('list', 'get'))
    if subcommand == 'stash':
        return first_positional(before) in ('list', 'show')
    if subcommand == 'reflog':
        return first_positional(before) in (None, 'show')
    if resolve_alias and subcommand:
        expanded = expand_alias(subcommand)
        if expanded:
            return is_read_only_command([*expanded, *rest], resolve_alias=False)
    return False


def unreadable_metadata_path(git_dir):
    """Return the first unreadable essential Git metadata path, or None."""
    head = git_dir / 'HEAD'
    if not os.access(head, os.R_OK):
        return head
    try:
        target = head.read_text().strip()
    except OSError:
        return head
    if target.startswith('ref: '):
        ref_rel = Path(target[5:].strip())
        current = git_dir
        for part in ref_rel.parts[:-1]:
            current = current / part
            try:
                st = current.lstat()
            except PermissionError:
                return current
            except FileNotFoundError:
                break
            if stat.S_ISDIR(st.st_mode) and not os.access(current, os.R_OK | os.X_OK):
                return current
        else:
            ref_path = git_dir / ref_rel
            try:
                ref_path.lstat()
            except PermissionError:
                return ref_path
            except FileNotFoundError:
                pass
            else:
                if not os.access(ref_path, os.R_OK):
                    return ref_path
    for name in ('packed-refs', 'index', 'config'):
        path = git_dir / name
        try:
            path.lstat()
        except PermissionError:
            return path
        except FileNotFoundError:
            continue
        if not os.access(path, os.R_OK):
            return path
    for rel in ('refs', 'refs/heads', 'refs/remotes', 'refs/tags', 'objects', 'objects/pack'):
        directory = git_dir / rel
        try:
            st = directory.lstat()
        except PermissionError:
            return directory
        except FileNotFoundError:
            continue
        if stat.S_ISDIR(st.st_mode) and not os.access(directory, os.R_OK | os.X_OK):
            return directory
    for directory in (git_dir / 'objects', git_dir / 'objects/pack'):
        if not directory.is_dir():
            continue
        try:
            with os.scandir(directory) as entries:
                for entry in entries:
                    mode = os.R_OK | os.X_OK if entry.is_dir(follow_symlinks=False) else os.R_OK
                    if not os.access(entry.path, mode):
                        return Path(entry.path)
        except PermissionError:
            return directory
    return None


def git_command(args):
    if os.geteuid() != 0 and SYSTEM_GIT_DIR.is_dir():
        if not os.access(SYSTEM_GIT_DIR, os.W_OK) and not is_read_only_command(args):
            subcommand, _ = split_git_command(args)
            label = f"'{subcommand}'" if subcommand else 'this command'
            raise RuntimeError(f'{label} modifies the system repository and requires root.\n'
                               'Run this system repository operation with sudo agentoo git ...')
        if not is_help_or_version(args):
            unreadable = unreadable_metadata_path(SYSTEM_GIT_DIR)
            if unreadable is not None:
                raise RuntimeError(
                    f'cannot read {unreadable}; system repository metadata requires root.\n'
                    f'Run with sudo agentoo git ..., or fix metadata readability with: sudo chmod -R a+rX {SYSTEM_GIT_DIR}')
    command = ['git', f'--git-dir={SYSTEM_GIT_DIR}', f'--work-tree={SYSTEM_WORK_TREE}', *args]
    if os.geteuid() == 0 and (not args or args[0] not in GUARD_BYPASS):
        command = [sys.executable, str(SHARE / 'lib/git_transaction.py'), *command]
    return command


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        build_parser().print_help()
        return 0
    if args[0] != 'enable-write':
        if args[0] == 'git':
            args = args[1:]
        command = git_command(args)
        if os.geteuid() != 0 and SYSTEM_GIT_DIR.is_dir() and not os.access(SYSTEM_GIT_DIR, os.W_OK):
            os.environ['GIT_OPTIONAL_LOCKS'] = '0'
        os.execvp(command[0], command)
    parsed = build_parser().parse_args(args)
    if os.geteuid() != 0:
        print(f'agentoo: git {parsed.operation} requires root; requesting sudo authorization.', file=sys.stderr)
        os.execvp('sudo', ['sudo', *(['-n'] if parsed.no_input else []), '--', sys.executable,
                          str(Path(__file__).resolve()), *args])
    subprocess.run(git_command(['remote', 'set-url', 'origin', SSH_REMOTE]), check=True)
    # Secrets may have installed a separate HTTPS push URL. Remove it so
    # native Git inherits the SSH fetch URL for pushes too.
    result = subprocess.run(git_command(['config', '--unset-all', 'remote.origin.pushurl']))
    if result.returncode not in (0, 5):  # 5: no push override was present.
        raise subprocess.CalledProcessError(result.returncode, result.args)
    print(f'origin now uses SSH for fetch and push: {SSH_REMOTE}', file=sys.stderr)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode if error.returncode >= 0 else 128 - error.returncode)
    except (OSError, RuntimeError) as error:
        print(f'agentoo git: {error}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
